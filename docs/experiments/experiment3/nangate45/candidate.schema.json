{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://r2g.local/schemas/experiment3_nangate45_candidate.schema.json",
  "title": "Nangate45 Experiment 3 bounded antenna repair candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate_id",
    "candidate_version",
    "source_model",
    "failure_domain",
    "strategy",
    "rationale",
    "applicability",
    "config_edits",
    "action_policy_sha256"
  ],
  "properties": {
    "candidate_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{2,63}$"},
    "candidate_version": {"type": "integer", "minimum": 1},
    "source_model": {"type": "string", "minLength": 1},
    "failure_domain": {"enum": ["antenna_drc", "setup_timing"]},
    "strategy": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"},
    "action_policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "rationale": {"type": "string", "minLength": 1, "maxLength": 2000},
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "required_failure_signatures"],
      "properties": {
        "platform": {"const": "nangate45"},
        "required_failure_signatures": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string"}
        },
        "notes": {"type": "string", "maxLength": 1000}
      }
    },
    "config_edits": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 3,
      "propertyNames": {
        "enum": [
          "SKIP_ANTENNA_REPAIR",
          "MAX_REPAIR_ANTENNAS_ITER_GRT",
          "MAX_REPAIR_ANTENNAS_ITER_DRT",
          "ABC_AREA",
          "ABC_CLOCK_PERIOD_IN_PS",
          "ENABLE_PLACE_REPAIR_TIMING",
          "SETUP_SLACK_MARGIN",
          "SYNTH_HIERARCHICAL"
        ]
      },
      "additionalProperties": {
        "enum": ["0", "1", "3", "5", "10", "8000", "0.2"]
      }
    }
  }
}
