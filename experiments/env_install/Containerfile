# Experiment 1 base OS (the recorded prerequisite step): Ubuntu 22.04 + ONLY the documented prerequisites of the
# clean install (experiments/install_acceptance/README.md): Git, curl, CA certificates, Python with venv, GNU time.
# No EDA tool, PDK, cache or credential; the installer runs as the ordinary user "tester" (no sudo).
FROM docker.io/library/ubuntu:22.04
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      git curl ca-certificates python3 python3-venv time bzip2 xz-utils \
 && rm -rf /var/lib/apt/lists/* \
 && useradd -m -s /bin/bash tester
USER tester
WORKDIR /home/tester
