    "hard_preconditions": {"type": "array", "items": {"type": "string"}},
    "context_predicates": {"type": "object"},
    "obligations": {"type": "array", "items": {"type": "string"}},
    "validity_status": {"enum": ["CANDIDATE", "REJECT_DEGENERATE", "REJECT_UNFAITHFUL", "PROVISIONAL_VALID", "VALIDATED", "UNSTABLE_CANDIDATE", "INSTANCE_MEMORY"]},
    "validity_profile": {"type": "object"},
    "confidence": {"type": "object"},
    "utility": {"type": "object"},
    "risk_profiles": {"type": "array"},
    "source_episodes": {"type": "array", "items": {"type": "string"}}
  }
}
