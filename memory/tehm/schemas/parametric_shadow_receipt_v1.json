{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tehm://schemas/parametric_shadow_receipt_v1",
  "title": "TEHM Parametric Shadow Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_version",
    "record_type",
    "receipt_id",
    "case_id",
    "join_key",
    "proposal_digest",
    "target_graph_context_digest",
    "action_digest",
    "provenance",
    "proposal",
    "canonical_memory_mutation",
    "promotion_eligible"
  ],
  "properties": {
    "record_version": {"const": "parametric-shadow-receipt-v1"},
    "record_type": {"const": "shadow_receipt"},
    "receipt_id": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1},
    "join_key": {"type": "string", "minLength": 1},
    "proposal_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "target_graph_context_digest": {"type": "string", "minLength": 1},
    "action": {"type": "object"},
    "action_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate_rank": {"type": ["integer", "null"], "minimum": 1},
    "mode": {"enum": ["observation", "decision"], "default": "observation"},
    "provenance": {"type": "object"},
    "proposal": {"type": "object"},
    "canonical_counts_before": {"type": "object"},
    "canonical_memory_mutation": {"const": "none"},
    "promotion_eligible": {"const": false}
  }
}
