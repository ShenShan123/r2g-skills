{
  "schema_version": "rtl_corpus_policy_v1",
  "engineering_quality_schema": "rtl_eq_v1",
  "training_value_schema": "rtl_tv_v1",
  "functional_schema": "rtl_fc_v1",
  "pipeline_schema": "rtl_pipeline_v2",
  "family_schema": "rtl_family_v1",
  "split_schema": "rtl_split_v1",
  "split_group_schema": "rtl_split_group_closure_v1",
  "equivalence_schema": "rtl_equiv_v1",
  "synthesis_schema": "rtl_synth_v1",
  "frontier_schema": "rtl_frontier_v1",
  "acquisition_schema": "rtl_acquisition_v1",
  "scheduler_schema": "rtl_discovery_scheduler_v3",
  "storage_schema": "rtl_storage_layout_v2",
  "max_repair_attempt": 4,
  "automatic_repair_levels": ["R1"],
  "allow_repository_code_execution": false,
  "archive_first_acquisition": true,
  "canonicalize_repository_before_acquisition": true,
  "immutable_repository_revision_storage": true,
  "require_stage_funnel_conservation": true,
  "phase1_unique_repository_revision_target": 1000,
  "require_contamination_audit_for_gold": true,
  "require_family_level_split": true,
  "require_shared_source_closure_split_group": true,
  "require_hierarchy_related_split_group": true,
  "require_project_target_split_group": true,
  "freeze_split_assignments": true,
  "default_split_percentages": {"train": 90, "val": 5, "test": 5},
  "license_statuses": ["PERMISSIVE_CONFIRMED", "COPYLEFT_CONFIRMED", "RESEARCH_ONLY", "UNKNOWN", "INCOMPATIBLE"],
  "release_policies": ["PUBLIC_EXPORT_ALLOWED", "INTERNAL_TRAINING_ONLY", "QUARANTINE", "EXCLUDED"],
  "retain_failed_and_excluded": true,
  "exclude_top_patterns": ["tb_*", "test_*", "sim_*", "formal_*", "verification_*", "*_tb"],
  "training_tiers": ["TRAINING_PREMIUM", "TRAINING_GOLD", "TRAINING_SILVER", "TRAINING_AUXILIARY", "TRAINING_EXCLUDED"]
}
