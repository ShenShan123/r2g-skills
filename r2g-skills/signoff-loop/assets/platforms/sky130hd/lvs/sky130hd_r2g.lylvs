#max_res(1000000)
#min_caps(1e-15)

r2g_matched = compare
if ! r2g_matched
  puts "ERROR : Netlists don't match"
else
  puts "INFO : Congratulations! Netlists match."
end

# R2G 2026-10-07: the deck never called report_lvs, so `report_file` -- passed
# in by the Makefile -- was ignored and a mismatch left nothing to inspect.
begin
  if $report_file
    report_lvs($report_file)
  end
rescue =&gt; e
  puts "R2G-LVS: report_lvs raised: #{e}"
end

# On a mismatch, say WHAT differs. Four designs were investigated with only the
# verdict to go on before this existed. each_net_pair and friends live on the
# NetlistCrossReference and take ONE argument (the circuit pair); the deck's own
# earlier dump guessed otherwise and died on `undefined method `device_count''.
if ! r2g_matched
  begin
    x = lvs_data.xref
    if x.nil?
      puts "R2G-LVS: no cross-reference available"
    else
      x.each_circuit_pair do |cp|
        la = cp.first ? cp.first.name : "(none)"
        sa = cp.second ? cp.second.name : "(none)"
        st = cp.status.to_s
        next if st == "Match"
        puts "R2G-LVS: circuit layout=#{la} schematic=#{sa} status=#{st}"
        next if cp.first.nil?
        next if cp.second.nil?
        shown = 0
        x.each_net_pair(cp) do |np|
          s = np.status.to_s
          next if s == "Match"
          next if s == "MatchWithWarning"
          shown = shown + 1
          next if shown &gt; 10
          na = np.first ? np.first.expanded_name : "(none)"
          nb = np.second ? np.second.expanded_name : "(none)"
          puts "R2G-LVS:   net [#{s}] layout=#{na} schematic=#{nb}"
        end
        shown = 0
        x.each_device_pair(cp) do |dp|
          s = dp.status.to_s
          next if s == "Match"
          next if s == "MatchWithWarning"
          shown = shown + 1
          next if shown &gt; 6
          da = dp.first ? dp.first.expanded_name : "(none)"
          db = dp.second ? dp.second.expanded_name : "(none)"
          puts "R2G-LVS:   device [#{s}] layout=#{da} schematic=#{db}"
        end
      end
    end
  rescue =&gt; e
    puts "R2G-LVS: cross-reference dump raised: #{e}"
  end
end</text>
</klayout-macro>
